  <!-- TYPE 1 : CHOIX MULTIPLES (multichoice)                                 -->
  <!-- ===================================================================== -->
  <!-- question: 101  -->
  <question type="multichoice">
    <name>
      <text>Q01 - Choix multiples - Concentration massique</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Quelle est la formule générale permettant de calculer la concentration massique d'une solution ?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>La formule originale est \( C = \frac{m}{V} \), où \( m \) est la masse du soluté (g) et \( V \) le volume de la solution (L).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>Q01</idnumber>
    <tags>
      <tag><text>Sec4_ST</text></tag>
      <tag><text>Chimie</text></tag>
      <tag><text>Concentration</text></tag>
    </tags>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[\( C = \frac{m}{V} \)]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Exact. La concentration massique est le rapport entre la masse du soluté et le volume de la solution.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[\( C = m \cdot V \)]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. Multiplier la masse par le volume donne une grandeur sans signification physique usuelle.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[\( C = \frac{V}{m} \)]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Attention. Il s'agit du volume massique (l'inverse de la concentration).</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[\( C = \frac{n}{V} \)]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Attention. Ceci correspond à la concentration molaire, non à la concentration massique.</p>]]></text>
      </feedback>
    </answer>
  </question>

