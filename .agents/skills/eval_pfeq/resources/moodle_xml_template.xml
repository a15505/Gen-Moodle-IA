  <!-- TYPE 7 : VRAI OU FAUX (truefalse)                                      -->
  <!-- ===================================================================== -->
  <!-- question: 107  -->
  <question type="truefalse">
    <name>
      <text>Q07 - Vrai ou Faux - Loi de la conservation de la masse</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Lors d'une transformation chimique dans un système fermé, la masse totale des réactifs consommés est toujours égale à la masse totale des produits formés.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Selon le principe de conservation de Lavoisier (« Rien ne se perd, rien ne se crée, tout se transforme »), le nombre d'atomes de chaque sorte est conservé.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>Q07</idnumber>
    <answer fraction="100" format="moodle_auto_format">
      <text>true</text>
      <feedback format="html">
        <text><![CDATA[<p>Exact. La masse est rigoureusement conservée dans un système fermé.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="moodle_auto_format">
      <text>false</text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. La masse ne peut ni disparaître ni être créée ex nihilo.</p>]]></text>
      </feedback>
    </answer>
  </question>

