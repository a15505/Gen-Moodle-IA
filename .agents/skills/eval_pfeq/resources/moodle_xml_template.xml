  <!-- TYPE 5 : QUESTION NUMÉRIQUE AVEC UNITÉS (numerical)                    -->
  <!-- ===================================================================== -->
  <!-- question: 105  -->
  <question type="numerical">
    <name>
      <text>Q05 - Calcul numérique - Concentration massique</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>On dissout \( 12\text{ g} \) de chlorure de sodium (\(\text{NaCl}\)) dans de l'eau pour préparer \( 250\text{ mL} \) de solution. Calculez la concentration massique de cette solution en \( \text{g/L} \).</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p><strong>Démarche scientifique (PFEQ) :</strong></p>
<p>Formule originale intacte : \( C = \frac{m}{V} \)</p>
<p>Données : \( m = 12\text{ g} \), \( V = 250\text{ mL} = 0{,}25\text{ L} \)</p>
<p>Substitution : \( C = \frac{12\text{ g}}{0{,}25\text{ L}} = 48\text{ g/L} \)</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber>Q05</idnumber>
    <answer fraction="100" format="moodle_auto_format">
      <text>48</text>
      <tolerance>0.5</tolerance>
      <feedback format="html">
        <text><![CDATA[<p>Parfait ! La concentration est exactement de 48 g/L.</p>]]></text>
      </feedback>
    </answer>
    <units>
      <unit>
        <multiplier>1</multiplier>
        <unit_name>g/L</unit_name>
      </unit>
      <unit>
        <multiplier>0.001</multiplier>
        <unit_name>g/mL</unit_name>
      </unit>
    </units>
  </question>

